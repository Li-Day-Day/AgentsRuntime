#!/usr/bin/env bash
set -euo pipefail

umask "${CLAWMANAGER_TEAM_UMASK:-0002}"

export HOME="${HOME:-/config}"
export HERMES_HOME="${HERMES_HOME:-${HOME}/.hermes}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
export NPM_CONFIG_CACHE="${NPM_CONFIG_CACHE:-${XDG_CACHE_HOME}/npm}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-${XDG_CACHE_HOME}/uv}"
export HERMES_ACCEPT_HOOKS="${HERMES_ACCEPT_HOOKS:-1}"

mkdir -p \
    "${HERMES_HOME}" \
    "${NPM_CONFIG_CACHE}" \
    "${UV_CACHE_DIR}" \
    "${XDG_CONFIG_HOME}" \
    "${XDG_DATA_HOME}"

/usr/local/bin/hermes-apply-runtime-config >/dev/null 2>&1 || true

env_file="${HERMES_HOME}/.env"
if [ -f "${env_file}" ]; then
    while IFS= read -r line || [ -n "${line:-}" ]; do
        line="${line%$'\r'}"
        [[ "${line}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
        key="${line%%=*}"
        value="${line#*=}"
        if [[ "${value}" == \"*\" && "${value}" == *\" ]]; then
            value="${value:1:${#value}-2}"
            value="${value//\\\"/\"}"
            value="${value//\\\\/\\}"
        elif [[ "${value}" == \'*\' && "${value}" == *\' ]]; then
            value="${value:1:${#value}-2}"
        fi
        export "${key}=${value}"
    done <"${env_file}"
fi

port="${CLAWMANAGER_GATEWAY_PORT:-${PORT:-9119}}"
host="${HOST:-0.0.0.0}"

case "${port}" in
    ''|*[!0-9]*)
        echo "invalid Hermes dashboard port: ${port}" >&2
        exit 64
        ;;
esac

team_worker_port="${HERMES_TEAM_WORKER_PORT:-${CLAWMANAGER_TEAM_WORKER_PORT:-$((port + 10000))}}"
case "${team_worker_port}" in
    ''|*[!0-9]*)
        echo "invalid Hermes Redis Team worker port: ${team_worker_port}" >&2
        exit 64
        ;;
esac
if [ "${team_worker_port}" -lt 1 ] || [ "${team_worker_port}" -gt 65535 ] || [ "${team_worker_port}" -eq "${port}" ]; then
    echo "Hermes Redis Team worker port must be distinct and within 1..65535: ${team_worker_port}" >&2
    exit 64
fi

truthy() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|y|on|enabled) return 0 ;;
        *) return 1 ;;
    esac
}

falsey() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        0|false|no|n|off|disabled) return 0 ;;
        *) return 1 ;;
    esac
}


should_start_team_gateway() {
    truthy "${CLAWMANAGER_TEAM_ENABLED:-}" || return 1
    falsey "${CLAWMANAGER_TEAM_AUTORUN:-true}" && return 1
    [ -n "${CLAWMANAGER_TEAM_REDIS_URL:-}" ] &&
        [ -n "${CLAWMANAGER_TEAM_ID:-}" ] &&
        [ -n "${CLAWMANAGER_TEAM_MEMBER_ID:-}" ]
}

team_gateway_pid=""
dashboard_pid=""
agent_pid=""

start_instance_agent() {
    if [ "${CLAWMANAGER_AGENT_ENABLED:-false}" != "true" ]; then
        return 0
    fi
    if [ ! -x /usr/local/bin/clawmanager-agent ]; then
        echo "ClawManager instance agent binary missing or not executable" >&2
        return 0
    fi
    if [ -z "${CLAWMANAGER_AGENT_BOOTSTRAP_TOKEN:-}" ] && [ -z "${CLAWMANAGER_AGENT_SESSION_TOKEN:-}" ]; then
        echo "ClawManager instance agent skipped: missing bootstrap/session token" >&2
        return 0
    fi

    echo "Starting ClawManager Hermes instance agent for instance ${CLAWMANAGER_AGENT_INSTANCE_ID:-unknown}"
    (
        unset RUNTIME_AGENT_CONTROL_TOKEN
        unset RUNTIME_AGENT_REPORT_TOKEN
        unset RUNTIME_AGENT_DATA_DIR
        unset RUNTIME_AGENT_PUBLIC_PORT
        unset RUNTIME_AGENT_LISTEN_ADDR

        /usr/local/bin/clawmanager-agent &
        child_pid="$!"
        trap 'kill "${child_pid}" 2>/dev/null || true; wait "${child_pid}" 2>/dev/null || true; exit 143' INT TERM
        set +e
        wait "${child_pid}"
        status="$?"
        trap - INT TERM
        if [ "${status}" -ne 0 ]; then
            echo "ClawManager Hermes instance agent exited with status ${status}" >&2
        else
            echo "ClawManager Hermes instance agent exited" >&2
        fi
        exit "${status}"
    ) &
    agent_pid="$!"
}

shutdown() {
    trap - INT TERM
    if [ -n "${dashboard_pid}" ]; then
        kill "${dashboard_pid}" 2>/dev/null || true
    fi
    if [ -n "${agent_pid}" ]; then
        kill "${agent_pid}" 2>/dev/null || true
    fi
    if [ -n "${team_gateway_pid}" ]; then
        kill "${team_gateway_pid}" 2>/dev/null || true
    fi
    wait 2>/dev/null || true
    exit 143
}

trap shutdown INT TERM


start_instance_agent

echo "Starting Hermes dashboard gateway: dashboard_port=${port} host=${host}"
hermes dashboard \
    --host "${host}" \
    --port "${port}" \
    --no-open \
    --insecure \
    --skip-build &
dashboard_pid="$!"
echo "Hermes dashboard gateway started: dashboard_pid=${dashboard_pid} dashboard_port=${port}"

if should_start_team_gateway; then
    echo "Starting Hermes Redis Team consumer: member=${CLAWMANAGER_TEAM_MEMBER_ID} dashboard_port=${port} team_worker_port=${team_worker_port}"
    (
        dashboard_hermes_home="${HERMES_HOME}"
        team_worker_home="${HERMES_TEAM_WORKER_HOME:-${HOME}/.clawmanager-team-worker}"
        export HOME="${team_worker_home}"
        export HERMES_HOME="${team_worker_home}/.hermes"
        export XDG_CACHE_HOME="${team_worker_home}/.cache"
        export XDG_CONFIG_HOME="${team_worker_home}/.config"
        export XDG_DATA_HOME="${team_worker_home}/.local/share"
        export NPM_CONFIG_CACHE="${XDG_CACHE_HOME}/npm"
        export UV_CACHE_DIR="${XDG_CACHE_HOME}/uv"
        export CLAWMANAGER_GATEWAY_PORT="${team_worker_port}"
        export PORT="${team_worker_port}"
        mkdir -p \
            "${HERMES_HOME}" \
            "${NPM_CONFIG_CACHE}" \
            "${UV_CACHE_DIR}" \
            "${XDG_CONFIG_HOME}" \
            "${XDG_DATA_HOME}"
        for managed_identity in SOUL.md AGENTS.md team.json team-introduction.md; do
            if [ -f "${dashboard_hermes_home}/${managed_identity}" ] && [ ! -e "${HERMES_HOME}/${managed_identity}" ]; then
                cp "${dashboard_hermes_home}/${managed_identity}" "${HERMES_HOME}/${managed_identity}"
            fi
        done
        /usr/local/bin/hermes-apply-runtime-config >/dev/null 2>&1 || true
        cd "${team_worker_home}"
        exec hermes gateway run --accept-hooks --no-supervise
    ) &
    team_gateway_pid="$!"
    echo "Hermes Redis Team consumer started: team_gateway_pid=${team_gateway_pid} team_worker_port=${team_worker_port}"
fi

set +e
wait "${dashboard_pid}"
status="$?"
set -e
dashboard_pid=""

if [ -n "${agent_pid}" ]; then
    kill "${agent_pid}" 2>/dev/null || true
    wait "${agent_pid}" 2>/dev/null || true
fi

if [ -n "${team_gateway_pid}" ]; then
    kill "${team_gateway_pid}" 2>/dev/null || true
    team_status=0
    wait "${team_gateway_pid}" 2>/dev/null || team_status="$?"
    echo "Hermes Redis Team consumer stopped: team_gateway_pid=${team_gateway_pid} status=${team_status}"
fi

exit "${status}"
