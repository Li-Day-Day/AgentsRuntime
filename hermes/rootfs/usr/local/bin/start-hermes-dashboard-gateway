#!/usr/bin/env bash
set -euo pipefail

export HOME="${HOME:-/config}"
export HERMES_HOME="${HERMES_HOME:-${HOME}/.hermes}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
export NPM_CONFIG_CACHE="${NPM_CONFIG_CACHE:-${XDG_CACHE_HOME}/npm}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-${XDG_CACHE_HOME}/uv}"
export HERMES_ACCEPT_HOOKS="${HERMES_ACCEPT_HOOKS:-1}"

mkdir -p \
    "${HERMES_HOME}" \
    "${NPM_CONFIG_CACHE}" \
    "${UV_CACHE_DIR}" \
    "${XDG_CONFIG_HOME}" \
    "${XDG_DATA_HOME}"

env_file="${HERMES_HOME}/.env"
if [ -f "${env_file}" ]; then
    while IFS= read -r line || [ -n "${line:-}" ]; do
        line="${line%$'\r'}"
        [[ "${line}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
        key="${line%%=*}"
        value="${line#*=}"
        if [[ "${value}" == \"*\" && "${value}" == *\" ]]; then
            value="${value:1:${#value}-2}"
            value="${value//\\\"/\"}"
            value="${value//\\\\/\\}"
        elif [[ "${value}" == \'*\' && "${value}" == *\' ]]; then
            value="${value:1:${#value}-2}"
        fi
        export "${key}=${value}"
    done <"${env_file}"
fi

port="${CLAWMANAGER_GATEWAY_PORT:-${PORT:-9119}}"
host="${HOST:-0.0.0.0}"

case "${port}" in
    ''|*[!0-9]*)
        echo "invalid Hermes dashboard port: ${port}" >&2
        exit 64
        ;;
esac

truthy() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|y|on|enabled) return 0 ;;
        *) return 1 ;;
    esac
}

falsey() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        0|false|no|n|off|disabled) return 0 ;;
        *) return 1 ;;
    esac
}

# Newer Hermes ignores --insecure for non-loopback binds; require a dashboard
# auth provider (basic auth) before binding HOST=0.0.0.0.
ensure_dashboard_basic_auth() {
    if [ -n "${HERMES_DASHBOARD_BASIC_AUTH_USERNAME:-}" ] && {
        [ -n "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD:-}" ] ||
            [ -n "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH:-}" ]
    }; then
        return 0
    fi

    export HERMES_DASHBOARD_BASIC_AUTH_USERNAME="${HERMES_DASHBOARD_BASIC_AUTH_USERNAME:-clawmanager}"

    if [ -z "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD:-}" ] && [ -z "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH:-}" ]; then
        if [ -n "${CLAWMANAGER_DASHBOARD_BASIC_AUTH_PASSWORD:-}" ]; then
            export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${CLAWMANAGER_DASHBOARD_BASIC_AUTH_PASSWORD}"
        elif [ -n "${CLAWMANAGER_INSTANCE_ACCESS_TOKEN:-}" ]; then
            export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${CLAWMANAGER_INSTANCE_ACCESS_TOKEN}"
        elif [ -n "${CLAWMANAGER_INSTANCE_TOKEN:-}" ]; then
            # ClawManager BuildGatewayEnv currently ships this key for AccessToken.
            export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${CLAWMANAGER_INSTANCE_TOKEN}"
        elif [ -n "${CLAWMANAGER_GATEWAY_TOKEN:-}" ]; then
            export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${CLAWMANAGER_GATEWAY_TOKEN}"
        else
            auth_file="${HERMES_HOME}/.clawmanager-dashboard-basic-auth"
            if [ -f "${auth_file}" ]; then
                export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="$(tr -d '\r\n' <"${auth_file}")"
            else
                if command -v openssl >/dev/null 2>&1; then
                    generated_password="$(openssl rand -hex 16)"
                else
                    generated_password="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
                fi
                umask 077
                printf '%s' "${generated_password}" >"${auth_file}"
                export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${generated_password}"
            fi
        fi
    fi
}

should_start_team_gateway() {
    truthy "${CLAWMANAGER_TEAM_ENABLED:-}" || return 1
    falsey "${CLAWMANAGER_TEAM_AUTORUN:-true}" && return 1
    [ -n "${CLAWMANAGER_TEAM_REDIS_URL:-}" ] &&
        [ -n "${CLAWMANAGER_TEAM_ID:-}" ] &&
        [ -n "${CLAWMANAGER_TEAM_MEMBER_ID:-}" ]
}

team_gateway_pid=""
dashboard_pid=""
agent_pid=""

start_instance_agent() {
    if [ "${CLAWMANAGER_AGENT_ENABLED:-false}" != "true" ]; then
        return 0
    fi
    if [ ! -x /usr/local/bin/clawmanager-agent ]; then
        echo "ClawManager instance agent binary missing or not executable" >&2
        return 0
    fi
    if [ -z "${CLAWMANAGER_AGENT_BOOTSTRAP_TOKEN:-}" ] && [ -z "${CLAWMANAGER_AGENT_SESSION_TOKEN:-}" ]; then
        echo "ClawManager instance agent skipped: missing bootstrap/session token" >&2
        return 0
    fi

    echo "Starting ClawManager Hermes instance agent for instance ${CLAWMANAGER_AGENT_INSTANCE_ID:-unknown}"
    (
        unset RUNTIME_AGENT_CONTROL_TOKEN
        unset RUNTIME_AGENT_REPORT_TOKEN
        unset RUNTIME_AGENT_DATA_DIR
        unset RUNTIME_AGENT_PUBLIC_PORT
        unset RUNTIME_AGENT_LISTEN_ADDR

        /usr/local/bin/clawmanager-agent &
        child_pid="$!"
        trap 'kill "${child_pid}" 2>/dev/null || true; wait "${child_pid}" 2>/dev/null || true; exit 143' INT TERM
        set +e
        wait "${child_pid}"
        status="$?"
        trap - INT TERM
        if [ "${status}" -ne 0 ]; then
            echo "ClawManager Hermes instance agent exited with status ${status}" >&2
        else
            echo "ClawManager Hermes instance agent exited" >&2
        fi
        exit "${status}"
    ) &
    agent_pid="$!"
}

shutdown() {
    trap - INT TERM
    if [ -n "${dashboard_pid}" ]; then
        kill "${dashboard_pid}" 2>/dev/null || true
    fi
    if [ -n "${agent_pid}" ]; then
        kill "${agent_pid}" 2>/dev/null || true
    fi
    if [ -n "${team_gateway_pid}" ]; then
        kill "${team_gateway_pid}" 2>/dev/null || true
    fi
    wait 2>/dev/null || true
    exit 143
}

trap shutdown INT TERM


start_instance_agent

if should_start_team_gateway; then
    echo "Starting Hermes Redis Team consumer for member ${CLAWMANAGER_TEAM_MEMBER_ID}"
    (
        cd "${HOME}"
        exec hermes gateway run --accept-hooks --no-supervise
    ) &
    team_gateway_pid="$!"
fi

ensure_dashboard_basic_auth

hermes dashboard \
    --host "${host}" \
    --port "${port}" \
    --no-open \
    --skip-build &
dashboard_pid="$!"

set +e
wait "${dashboard_pid}"
status="$?"
set -e
dashboard_pid=""

if [ -n "${agent_pid}" ]; then
    kill "${agent_pid}" 2>/dev/null || true
    wait "${agent_pid}" 2>/dev/null || true
fi

if [ -n "${team_gateway_pid}" ]; then
    kill "${team_gateway_pid}" 2>/dev/null || true
    wait "${team_gateway_pid}" 2>/dev/null || true
fi

exit "${status}"
