#!/usr/bin/with-contenv bash
set -euo pipefail

export HOME=/config
export DISPLAY=:1
export XDG_RUNTIME_DIR=/config/.XDG
export QT_QPA_PLATFORM=xcb

if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]]; then
    export WAYLAND_DISPLAY=wayland-0
    session_label="KDE/Xwayland"
    compositor_process="kwin_wayland"
else
    unset WAYLAND_DISPLAY
    export XDG_SESSION_TYPE=x11
    session_label="KDE/X11"
    compositor_process="kwin_x11"
fi

echo "[svc-workbuddy] Waiting for the ${session_label} session..."
while ! pgrep -u abc -x "$compositor_process" >/dev/null 2>&1; do
    sleep 0.5
done
while ! pgrep -u abc -x plasmashell >/dev/null 2>&1; do
    sleep 0.5
done
while ! s6-setuidgid abc env DISPLAY="$DISPLAY" xset q >/dev/null 2>&1; do
    sleep 0.5
done

# Join Plasma's session bus so desktop integration such as notifications and
# tray items works. Reading /proc as user abc also works with hidepid enabled.
plasma_pid="$(pgrep -u abc -x plasmashell | head -n 1)"
dbus_address="$(
    s6-setuidgid abc bash -c \
      'tr "\0" "\n" < "/proc/$1/environ"' bash "$plasma_pid" \
      | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' \
      | head -n 1
)"
if [[ -n "$dbus_address" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="$dbus_address"
fi

echo "[svc-workbuddy] Starting WorkBuddy as user abc..."
exec s6-setuidgid abc /usr/local/bin/start-workbuddy
