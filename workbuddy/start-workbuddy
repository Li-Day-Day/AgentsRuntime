#!/usr/bin/env bash
set -euo pipefail

# Webtop runs the desktop as user abc with HOME=/config. Keep all WorkBuddy
# state on the persistent /config volume and avoid starting a duplicate copy.
export HOME="${HOME:-/config}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME"

while IFS= read -r pid; do
    [[ -r "/proc/$pid/cmdline" ]] || continue
    mapfile -d '' -t argv < "/proc/$pid/cmdline" || true
    [[ "${argv[0]:-}" == "/opt/workbuddy/electron" ]] || continue

    is_child=false
    for arg in "${argv[@]:1}"; do
        case "$arg" in
            --version|--type=*|*app.asar/*|*app.asar.unpacked/*)
                is_child=true
                break
                ;;
        esac
    done
    if [[ "$is_child" == "false" ]]; then
        exit 0
    fi
done < <(pgrep -u "$(id -u)" -x electron 2>/dev/null || true)

exec /opt/workbuddy/start.sh "$@"
