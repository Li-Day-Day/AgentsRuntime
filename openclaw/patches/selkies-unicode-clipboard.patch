+    @staticmethod
+    def _clipboard_data_length(data):
+        return len(data) if data is not None else 0
+
+    @staticmethod
+    def _clipboard_data_matches(actual, expected):
+        if isinstance(actual, bytes) and isinstance(expected, str):
+            expected = expected.encode("utf-8")
+        elif isinstance(actual, str) and isinstance(expected, bytes):
+            actual = actual.encode("utf-8")
+        return actual == expected
+
+    async def _clear_system_clipboard(self):
+        env = self._get_wl_env() if self.is_wayland else os.environ.copy()
+        command = ["wl-copy", "--clear"] if self.is_wayland else [
+            "xclip", "-selection", "clipboard", "-i"
+        ]
+        try:
+            process = await subprocess.create_subprocess_exec(
+                *command,
+                stdin=None if self.is_wayland else subprocess.PIPE,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                env=env,
+            )
+            if not self.is_wayland and process.stdin:
+                process.stdin.close()
+            await asyncio.wait_for(process.communicate(), timeout=1.0)
+            return process.returncode == 0
+        except Exception:
+            return False
+
+    async def _write_clipboard_value(self, data, mime_type="text/plain"):
+        if data is None or data == "" or data == b"":
+            return await self._clear_system_clipboard()
+        return await self.write_clipboard(data, mime_type=mime_type or "text/plain")
+
+    async def _write_inbound_clipboard(self, data, mime_type="text/plain"):
+        async with self.clipboard_injection_lock:
+            data_length = self._clipboard_data_length(data)
+            if self.clipboard_paused:
+                self.pending_inbound_clipboard = (data, mime_type)
+                logger_webrtc_input.info(
+                    "Clipboard direction=inbound length=%d status=queued", data_length
+                )
+                return False
+
+            success = await self._write_clipboard_value(data, mime_type)
+            logger_webrtc_input.info(
+                "Clipboard direction=inbound length=%d status=%s",
+                data_length,
+                "applied" if success else "error",
+            )
+            return success
+
+    async def _finish_unicode_clipboard(self):
+        try:
+            pending = self.pending_inbound_clipboard
+            self.pending_inbound_clipboard = None
+            if pending is not None:
+                data, mime_type = pending
+                success = await self._write_clipboard_value(data, mime_type)
+                logger_webrtc_input.info(
+                    "Clipboard direction=inbound length=%d status=%s",
+                    self._clipboard_data_length(data),
+                    "applied" if success else "error",
+                )
+                return
+
+            current_data, _ = await self.read_clipboard(use_binary=True)
+            if not self._clipboard_data_matches(
+                current_data, self.unicode_clipboard_last_injected
+            ):
+                logger_webrtc_input.info(
+                    "Clipboard direction=restore length=0 status=cas-skipped"
+                )
+                return
+
+            original_data, original_mime = self.unicode_clipboard_original or (None, None)
+            success = await self._write_clipboard_value(
+                original_data, original_mime or "text/plain"
+            )
+            logger_webrtc_input.info(
+                "Clipboard direction=restore length=%d status=%s",
+                self._clipboard_data_length(original_data),
+                "applied" if success else "error",
+            )
+        except Exception:
+            logger_webrtc_input.error(
+                "Clipboard direction=restore length=0 status=error"
+            )
+        finally:
+            restore_task = self.unicode_clipboard_restore_task
+            if (
+                restore_task is not None
+                and restore_task is not asyncio.current_task()
+            ):
+                restore_task.cancel()
+            self.clipboard_paused = False
+            self.unicode_clipboard_original = None
+            self.unicode_clipboard_original_captured = False
+            self.unicode_clipboard_last_injected = None
+            self.unicode_clipboard_restore_task = None
+
+    async def _restore_unicode_clipboard_after_delay(self):
+        restore_task = asyncio.current_task()
+        try:
+            await asyncio.sleep(self.UNICODE_CLIPBOARD_RESTORE_DELAY)
+            async with self.clipboard_injection_lock:
+                if self.unicode_clipboard_restore_task is restore_task:
+                    await self._finish_unicode_clipboard()
+        except asyncio.CancelledError:
+            async with self.clipboard_injection_lock:
+                if self.unicode_clipboard_restore_task is restore_task:
+                    await self._finish_unicode_clipboard()
+            raise
+        except Exception:
+            async with self.clipboard_injection_lock:
+                if self.unicode_clipboard_restore_task is restore_task:
+                    await self._finish_unicode_clipboard()
+
+    async def _wait_for_unicode_clipboard(self, text_to_type):
