#!/usr/bin/with-contenv bash
set -euo pipefail

if [ -n "${RUNTIME_AGENT_CONTROL_TOKEN:-}" ] || [ -n "${RUNTIME_AGENT_REPORT_TOKEN:-}" ]; then
  runtime_agent_data_dir="${RUNTIME_AGENT_DATA_DIR:-/var/lib/clawmanager-agent}"
  mkdir -p "${runtime_agent_data_dir}"
  exec /usr/local/bin/clawmanager-agent
fi

if [ "${CLAWMANAGER_AGENT_ENABLED:-false}" != "true" ]; then
  echo "ClawManager OpenCode instance agent disabled"
  exec sleep infinity
fi

export HOME="${HOME:-/config}"
export OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-/config/.opencode}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/config/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/config/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-/config/.local/share}"

mkdir -p \
  "${CLAWMANAGER_AGENT_PERSISTENT_DIR:-/config}/opencode-agent" \
  "${OPENCODE_CONFIG_DIR}" \
  "${XDG_CACHE_HOME}" \
  "${XDG_CONFIG_HOME}" \
  "${XDG_DATA_HOME}"

/usr/local/bin/opencode-apply-runtime-config || true

exec /usr/local/bin/clawmanager-agent
