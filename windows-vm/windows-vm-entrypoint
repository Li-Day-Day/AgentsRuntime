#!/usr/bin/env bash
set -Eeuo pipefail

export CLAWMANAGER_RUNTIME_TYPE="${CLAWMANAGER_RUNTIME_TYPE:-windows-vm}"
export RUNTIME_GATEWAY_PORT_START="${RUNTIME_GATEWAY_PORT_START:-8006}"
export RUNTIME_GATEWAY_PORT_END="${RUNTIME_GATEWAY_PORT_END:-8006}"
export RUNTIME_GATEWAY_PORT_BLOCK_SIZE="${RUNTIME_GATEWAY_PORT_BLOCK_SIZE:-1}"
export RUNTIME_GATEWAY_CAPACITY="${RUNTIME_GATEWAY_CAPACITY:-1}"
export RUNTIME_GATEWAY_STARTUP_HEALTH_TIMEOUT="${RUNTIME_GATEWAY_STARTUP_HEALTH_TIMEOUT:-5m}"
export RUNTIME_GATEWAY_STOP_TIMEOUT="${RUNTIME_GATEWAY_STOP_TIMEOUT:-2m}"

if [[ -n "${RUNTIME_AGENT_CONTROL_TOKEN:-}" || -n "${RUNTIME_AGENT_REPORT_TOKEN:-}" ]]; then
  exec /usr/local/bin/clawmanager-agent
fi

exec /run/entry.sh "$@"
