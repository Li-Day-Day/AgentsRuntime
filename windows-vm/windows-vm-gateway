#!/usr/bin/env bash
set -Eeuo pipefail

storage_dir="${WINDOWS_VM_STORAGE_DIR:-}"
shared_dir="${WINDOWS_VM_SHARED_DIR:-}"

prepare_link() {
  local target="$1"
  local link="$2"

  [[ -z "$target" ]] && return 0
  mkdir -p "$target"

  if [[ -L "$link" ]]; then
    local current
    current="$(readlink "$link")"
    [[ "$current" == "$target" ]] && return 0
    rm -f "$link"
  fi

  if [[ -d "$link" ]]; then
    if [[ -z "$(find "$link" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
      rmdir "$link"
      ln -s "$target" "$link"
    else
      echo "windows-vm: using existing non-empty $link directory"
    fi
    return 0
  fi

  if [[ ! -e "$link" ]]; then
    ln -s "$target" "$link"
  fi
}

prepare_link "$storage_dir" /storage
prepare_link "$shared_dir" /shared

exec /run/entry.sh
