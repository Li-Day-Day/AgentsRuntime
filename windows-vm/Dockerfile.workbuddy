# syntax=docker/dockerfile:1.7

ARG WINDOWS_VM_BASE_IMAGE=windows-vm:local
FROM ${WINDOWS_VM_BASE_IMAGE}

ARG WORKBUDDY_UPDATE_API="https://www.workbuddy.cn/v2/update?platform=workbuddy-win32-x64-user"
ARG WORKBUDDY_INSTALLER_URL=""
ARG EDGE_INSTALLER_URL="https://go.microsoft.com/fwlink/?LinkID=2093437"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux; \
  mkdir -p /oem; \
  url="${WORKBUDDY_INSTALLER_URL}"; \
  if [[ -z "${url}" ]]; then \
    url="$(curl -fsSL "${WORKBUDDY_UPDATE_API}" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')"; \
  fi; \
  test -n "${url}"; \
  curl -fL "${url}" -o /oem/WorkBuddySetup.exe; \
  curl -fL "${EDGE_INSTALLER_URL}" -o /oem/MicrosoftEdgeEnterpriseX64.msi; \
  chmod 0644 /oem/WorkBuddySetup.exe /oem/MicrosoftEdgeEnterpriseX64.msi

COPY windows-vm/oem/install.bat /oem/install.bat
COPY windows-vm/oem/workbuddy-install.ps1 /oem/workbuddy-install.ps1
COPY windows-vm/oem/default-app-associations.xml /oem/default-app-associations.xml

RUN chmod 0644 /oem/install.bat /oem/workbuddy-install.ps1 /oem/default-app-associations.xml
